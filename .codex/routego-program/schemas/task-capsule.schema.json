{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "routego-image-task-capsule.schema.json",
  "title": "Routego Image current OpenSpec task capsule",
  "type": "object",
  "required": [
    "schemaVersion",
    "contentSha256",
    "lane",
    "change",
    "taskId",
    "sourceCommit",
    "taskSource",
    "dependencies",
    "allowedFiles",
    "forbiddenFileGlobs",
    "requiredBehavior",
    "verification",
    "directSpecifications",
    "publicContractFingerprint",
    "ownershipFingerprint",
    "externalStateAuthorized"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contentSha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "taskId": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "allowedFiles": { "type": "array", "minItems": 1, "uniqueItems": true },
    "allowedParentDirectoriesToCreate": { "type": "array", "uniqueItems": true },
    "forbiddenFileGlobs": { "type": "array", "minItems": 1, "uniqueItems": true },
    "externalStateAuthorized": { "const": false }
  },
  "additionalProperties": true
}

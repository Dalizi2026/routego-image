  "requiredBehavior": [
    "Expose authenticated, same-origin browser endpoints for the existing safe mark and copy-generation-information Library operations, using strict schemas, bounded UTF-8 JSON bodies, no-store JSON responses, and path/credential/image-byte-free diagnostics.",

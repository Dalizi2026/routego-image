{
  "name": "routego-image",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:plugin": "node scripts/build-plugin-package.mjs",
    "build:plugin:windows": "node scripts/build-plugin-package.mjs --target windows",
    "check:exports": "node scripts/check-package-exports.mjs",
    "governance:validate-handoff": "node .codex/routego-program/scripts/validate-handoff-capsule.mjs",
    "safety": "node scripts/check-repository-safety.mjs",
    "typecheck": "tsc --project tsconfig.tooling.json --noEmit && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:browser": "playwright test",
    "verify:plugin": "node scripts/verify-plugin-package.mjs .routego-plugin-build/routego-image"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.10",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
